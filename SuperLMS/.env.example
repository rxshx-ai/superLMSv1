# ── Moodle Credentials ───────────────────────────────────────────────
MOODLE_URL=https://vitolcc.vit.ac.in
MOODLE_USERNAME=your_vit_username
MOODLE_PASSWORD=your_vit_password

# ── LLM Provider ─────────────────────────────────────────────────────
# "bedrock" → AWS Bedrock Claude (recommended)
# "groq"    → Groq Llama (fallback)
LLM_PROVIDER=bedrock

# ── AWS Bedrock ───────────────────────────────────────────────────────
AWS_REGION=us-east-1

# Leave blank if running on EC2 with an IAM role — no keys needed.
# Fill in only if running locally or without an IAM role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Claude model on Bedrock — choose one:
# us.anthropic.claude-3-5-sonnet-20241022-v2:0  ← recommended
# us.anthropic.claude-3-opus-20240229-v1:0       ← most powerful
# us.anthropic.claude-3-haiku-20240307-v1:0      ← fastest / cheapest
BEDROCK_MODEL=us.anthropic.claude-3-5-sonnet-20241022-v2:0

# ── Groq (fallback, only needed if LLM_PROVIDER=groq) ────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Agent Behaviour ───────────────────────────────────────────────────
POLL_INTERVAL=30
PUBLISH_STATE=draft
