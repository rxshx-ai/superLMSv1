# ── Moodle ───────────────────────────────────────────────────────────
# One shared LMS URL for every user.
MOODLE_URL=https://vitolcc.vit.ac.in

# Per-user accounts live in users.json (copy users.example.json → users.json).
# The two vars below are a single-user fallback used ONLY when users.json
# is absent — leave them blank if you use users.json.
MOODLE_USERNAME=
MOODLE_PASSWORD=

# ── LLM Provider ─────────────────────────────────────────────────────
# "groq"    → Groq Llama (default)
# "bedrock" → AWS Bedrock, any model via the Converse API + IAM role
LLM_PROVIDER=bedrock

# ── AWS Bedrock ───────────────────────────────────────────────────────
AWS_REGION=us-east-1

# Leave blank if running on EC2 with an IAM role — no keys needed.
# Fill in only if running locally or without an IAM role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Bedrock model ID. Invoked via the model-agnostic Converse API, so any
# Bedrock chat model works. Copy the exact ID from Bedrock → Model catalog;
# it may carry a region prefix (e.g. "us.moonshotai.kimi-k2.5").
#   moonshotai.kimi-k2.5                          ← Moonshot Kimi K2.5
#   us.anthropic.claude-3-5-sonnet-20241022-v2:0  ← Claude 3.5 Sonnet
BEDROCK_MODEL=moonshotai.kimi-k2.5

# ── Groq ─────────────────────────────────────────────────────────────
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Agent Behaviour ───────────────────────────────────────────────────
POLL_INTERVAL=30
PUBLISH_STATE=draft
